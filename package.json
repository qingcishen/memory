{
  "name": "cyber-memory",
  "version": "0.1.0",
  "description": "A human-like memory system for AI companions: selective recall, emotional state, reconsolidation, relationship memories, prospective memory, and multimodal memory.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingcishen/memory.git"
  },
  "keywords": [
    "ai-memory",
    "companion-ai",
    "memory-system",
    "rag",
    "pgvector",
    "reconsolidation",
    "prospective-memory",
    "multimodal-memory"
  ],
  "bugs": {
    "url": "https://github.com/qingcishen/memory/issues"
  },
  "homepage": "https://github.com/qingcishen/memory#readme",
  "scripts": {
    "demo": "node examples/demo.js",
    "eval:v2": "node examples/eval/companion-v2.eval.js",
    "eval:golden": "node examples/eval/golden-sessions.eval.js",
    "eval:replay": "node examples/eval/replay-sessions.eval.js",
    "eval:import": "node examples/eval/import-replay.eval.js",
    "eval:live-matrix": "node examples/eval/live-matrix.eval.js",
    "eval:live-chat": "node scripts/emotion-live-chat.js",
    "db:sql": "node scripts/run-sql.js",
    "companion:new": "node scripts/new-companion.js",
    "companion:validate": "node scripts/validate-companion.js",
    "integration:r2": "R2_LIVE_TEST=1 node examples/r2.test.js",
    "telegram": "node src/telegram/bot.js",
    "feishu": "node src/feishu/bot.js",
    "discord": "node src/discord/bot.js",
    "ui": "npm run ui:build && node src/ui/server.js",
    "ui:dev": "vite --config src/ui/vite.config.js",
    "ui:build": "vite build --config src/ui/vite.config.js",
    "inspect": "node examples/inspect.js",
    "test": "vitest run",
    "typecheck": "tsc --project jsconfig.json --noEmit",
    "bench:memory": "node --env-file=.env bench/run-memory-bench.js",
    "bench:retrieval": "node --env-file=.env bench/run-retrieval-comparison.js",
    "eval:dialogue": "node --env-file=.env bench/run-dialogue-eval.js",
    "bench:ablation": "node --env-file=.env bench/run-ablation.js",
    "bench:action-utility": "node --env-file=.env bench/eval-action-utility.js",
    "bench:clean": "node --env-file=.env bench/clean.js",
    "labels:prepare": "node scripts/label-from-traces.js",
    "labels:label": "node scripts/label-from-traces.js label",
    "labels:review": "node scripts/label-from-traces.js review",
    "labels:audit": "node scripts/label-from-traces.js audit",
    "labels:finalize": "node scripts/label-from-traces.js finalize",
    "labels:eval": "node scripts/eval-emotion-labels.js",
    "fit:forget-rate": "node scripts/fit-forget-rate.js"
  },
  "overrides": {
    "axios": "^1.16.0",
    "discord.js": {
      "undici": "^6.27.0"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@larksuiteoapi/node-sdk": "^1.70.0",
    "@supabase/supabase-js": "^2.45.0",
    "discord.js": "^14.26.5",
    "dotenv": "^16.4.5",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.24.0",
    "openai": "^4.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "undici": "^8.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "fast-glob": "^3.3.2",
    "pg": "^8.22.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^3.2.7"
  }
}
